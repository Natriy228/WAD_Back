<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Лента</title>
    <link rel="stylesheet" href="/WPCdesign.css">
</head>
<body>
    <div class="mainFrame">
	
		<div id="mainContainer" style="display:grid; grid-template-columns:1fr; grid-template-rows:1fr; width:100%; height:100vh">
		
			<div id="videoContainer" style="grid-area:1/1">
				<image style="width:100%; height:100%" src="/{{foundCard.img}}"></image>
			</div>
			
			<div id="buttonsContainer" style="grid-area:1/1; display:grid; align-content:end">
	
				<div id="videoControlsField" style="grid-area:1/1; display:flex; flex-direction:column; padding-left: 16px; padding-right: 16px">
					
					<div style="width:100%; display:grid; justify-content:right">
						<div style="width:14%; display:grid">
							<button class="controlButton" style="grid-area:1/2; font-size: 80px; width: 100%">♡</button>
							<p style="grid-area:1/1; width:100%; font-size:28px; color:#E1E3E6; text-align:center">{{foundCard.likes}}</p>
						</div>
					</div>
					
					<div style="width:100%; display:grid; justify-content:right; margin-bottom: 25%">
						<div style="width:14%">
							<form method="GET" action="/tiles/1"><input style="width:0px; height:0px " id="next" name="next" value="true"><button class="controlButton" style="font-size: 50px; width: 100%">⏩</button></form>
						</div>
					</div>
					
					<p style="width:100%; font-weight: bold; font-size:32px; color:#E1E3E6">{{foundCard.name}}</p>
					<p style="width:100%; font-size:20px; color:#E1E3E6">{{foundCard.desc}}</p>
					
				</div>
				
				<div id="controlPanel" style="position:relative; width:100%; height:9.15vh; grid-area:2/1">
					<div class="controlPanelMain" style="position:absolute; bottom:0">
						<table style="width:100%; height:100%; text-align:center;">
							<tr>
								<td><form method="GET" action="/tiles/1"><button class="controlButton" style="font-size:28px; margin-right:9%">=</button></form></td>
								<td><form method="GET" action="/tiles"><button class="controlButton" style="font-size:28px; margin-left:9%">::</button></form></td>
							</tr>
						</table>
					</div>
					<div class="controlPanelCircle" style="position:absolute; bottom:0">
						<form method="GET" action="/new"><button class="controlButton" style="font-size:64px;">+</button></form>
					</div>
				</div>
				
			</div>
			
		</div>
		
	</div>
</body>
</html>