<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Лента</title>
    <link rel="stylesheet" href="/WPCdesign.css">
</head>
<body>
    <div class="mainFrame">
	
		<div id="mainContainer" style="display:grid; grid-template-columns:1fr; grid-template-rows:1fr; align-items: end; width:100%; height:100vh">
		
			<div id="videoContainer" style="grid-area:1/1">
				
			</div>
			
			<div id="buttonsContainer" style="grid-area:1/1">
				
				<div style="width:100%; display:grid; justify-content:right; margin-bottom:5%">
					<div>
						<button class="controlButton"><image src="/icons/button_notliked.png" style="width:64px; height:64px"></image></button>
						<div style="font-size:28px; color:#E1E3E6; text-align:center">{{foundCard.likes}}</div>
					</div>
				</div>
				
				<div style="width:100%; display:grid; justify-content:right; margin-bottom:20%">
					<div>
						<form method="GET" action="/tiles/1">
							<input type="hidden" id="next" name="next" value="true">
							<button class="controlButton" style="font-size: 50px"><image src="/icons/button_next.png" style="width:64px; height:64px"></image></button>
						</form>
					</div>
				</div>
				
				<div style="width:100%; font-weight: bold; font-size:32px; color:#E1E3E6; margin-bottom:5%; margin-left:4%">{{foundCard.name}}</div>
				<div style="width:100%; font-size:20px; color:#E1E3E6; margin-bottom:30%; margin-left:4%">{{foundCard.desc}}</div>
				
			</div>
			
			{{> footer}}

		</div>
		
	</div>
</body>
</html>