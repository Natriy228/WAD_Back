<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Лента</title>
    <link rel="stylesheet" href="/WPCdesign.css">
</head>
<body>
    <div class="mainFrame">
	
		<div class="mainContainer">
		
			<div id="videoContainer" style="grid-area:1/1">
				<video src="{{foundCard.video}}" style="width:100%; height:99vh" autoplay loop muted playsinline></video>
			</div>
			
			<div id="buttonsContainer" style="grid-area:1/1">
				
				<div class="sideButtonContainer" style="margin-bottom:5%">
					<div>
						<button class="controlButton"><image src="/icons/button_notliked.png" style="width:64px; height:64px"></image></button>
						<div style="font-size:28px; color:#E1E3E6; text-align:center; text-shadow: 2px 2px 5px black">{{likes}}</div>
					</div>
				</div>
				
				<div class="sideButtonContainer" style="margin-bottom:20%">
					<div>
						<form method="GET" action="/waves/{{foundCard.id}}">
							<input type="hidden" id="next" name="next" value="true">
							<button class="controlButton" style="font-size: 50px"><image src="/icons/button_next.png" style="width:64px; height:64px"></image></button>
						</form>
					</div>
				</div>
				
				<div style="width:100%; font-weight: bold; font-size:32px; text-shadow: 2px 2px 5px black; color:#E1E3E6; margin-bottom:5%; margin-left:4%">{{foundCard.name}} (Эфф.: {{foundCard.effClass}})</div>
				<div style="width:100%; font-size:20px; color:#E1E3E6; text-shadow: 2px 2px 2px black; margin-bottom:30%; margin-left:4%">({{foundCard.lowWave}} ГГц - {{foundCard.highWave}} ГГц) {{foundCard.desc}}</div>
				
			</div>
			
			{{> footer}}

		</div>
		
	</div>
</body>
</html>