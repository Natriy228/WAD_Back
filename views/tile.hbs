<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Плитки</title>
    <link rel="stylesheet" href="/WPCdesign.css">
</head>
<body>
    <div class="mainFrame">
		
		<div class="mainContainer">
			
			<div style="height: 100%; grid-area:1/1">
				<div id="redactField">
					
					<div style="width:100%">
						<form method="GET" action="/waves/{{this.id}}" style="display:flex; gap:0px 8px; ; height:3.58vh; margin-left:1.49%; margin-right:1.49%">
							<input placeholder="Поиск по длине волны" name="waveLength" style="width:70%; height:100%" class="standartInput" type="text">
							<button class="submitButton" style="width:30%; height:100%">Найти</button>
						</form>
					</div>
					
					<div class="cardsTile">
						{{#each list}}
							{{#if this.img}}
								<div class="waveCard" style="background-image:url('{{this.img}}')">
							{{else}}
								<div class="waveCard" style="background-image:url('/gearsLoading')">
							{{/if}}
								<div id="deleteButton" style="width:96%; padding-right:2%; display:grid; justify-content:right">
									<form method="POST" action="/delete-card">
										<input type="hidden" id="reqID" name="reqID" value="{{this.id}}">
										<button style="background:rgba(0, 0, 0, 0); border:0"><image src="/icons/button_add.png" style="width:40px; height:40px; transform:rotate(45deg); cursor:pointer"></image></button>
									</form>
								</div>
								<div class="waveCardContent">
									<p class="waveCardTitle" style="text-shadow: 2px 2px 2px black">{{this.name}}</p>
									<p class="waveCardDescription" style="text-shadow: 2px 2px 2px black">{{this.desc}}</p>
								</div>
								<form method="GET" action="/waves/{{this.id}}"><button class="waveCardButton">Подробнее</button></form>
							</div>
						{{/each}}
					</div>
				</div>
			</div>
			
			{{> footer}}
			
		</div>
		
	</div>
</body>
</html>