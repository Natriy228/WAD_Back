<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Плитки</title>
    <link rel="stylesheet" href="/WPCdesign.css">
</head>
<body>
    <div class="mainFrame">
		
		<div id="mainContainer" style="display:grid; align-content:end; grid-template-columns:1fr; grid-template-rows:1fr; width:100%; height:100vh">
		
			<div id="redactField" style="grid-area:1/1">
				<div style="width:100%; height:4.58%">
					<table style="width:100%; height:100%">
						<tr>
						<td><input placeholder="Поиск по длине волны" style="width:100%; height:100%" class="standartInput" type="text"></td>
						<td><button class="submitButton" style="width:100%; height:100%">Найти</button></td>
						</tr>
					</table>
				</div>
				
				<div id="cardsTile" style="width:100%; margin-top:4px; display:flex; justify-content:flex-start; gap: 8px 1.49%; margin-left: 1.49%; flex-wrap: wrap">
					{{#each list}}
						<div class="waveCard" style="background-image:url('/{{this.img}}');">
							<div class="waveCardContent">
								<p class="waveCardTitle">{{this.name}}</p>
								<p class="waveCardDescription">{{this.desc}}</p>
							</div>
							<form method="GET" action="/tiles/{{this.id}}"><button class="waveCardButton">Подробнее</button></form>
						</div>
					{{/each}}
				</div>
			</div>
			
			<div id="controlPanel" style="position:relative; width:100%; height:9.15vh; grid-area:2/1">
				<div class="controlPanelMain" style="position:absolute; bottom:0">
					<table style="width:100%; height:100%; text-align:center;">
						<tr>
							<td><form method="GET" action="/tiles/1"><button class="controlButton" style="font-size:28px; margin-right:9%">=</button></form></td>
							<td><form method="GET" action="/tiles"><button class="controlButton" style="font-size:28px; margin-left:9%">::</button></form></td>
						</tr>
					</table>
				</div>
				<div class="controlPanelCircle" style="position:absolute; bottom:0">
					<form method="GET" action="/new"><button class="controlButton" style="font-size:64px;">+</button></form>
				</div>
			</div>
			
		</div>
		
	</div>
</body>
</html>