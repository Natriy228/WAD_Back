<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Добавление</title>
    <link rel="stylesheet" href="/WPCdesign.css">
</head>
<body>
    <div class="mainFrame">
	
		<div class="mainContainer">
		
			<div id="videoContainer" style="grid-area:1/1">
				<image style="width:100%; height:100%" src=""></image>
			</div>
			
			<div id="editContainer" style="grid-area:1/1; height:100%; display:grid; align-items:end">
					
				<div id="VIInputs" style="display:grid; width:98%; margin-bottom:10%; padding-left:1%">
					<input placeholder="~-" class="standartInput oneLineInput" type="text" value="{{foundCard.img}}">
					<input placeholder="~-" class="standartInput oneLineInput" type="text" style="margin-top:1%" value="{{foundCard.video}}">
				</div>
				
				<table style="margin:0; margin-bottom:30%">
					<tr>
					<td colspan="5"><input placeholder="Название" class="standartInput oneLineInput" type="text" value="{{foundCard.name}}"></td>
					</tr>
					<tr>
					<td colspan="2"><input placeholder="~-" class="standartInput oneLineInput" type="text" value="{{foundCard.lowWave}}"></td>
					<td colspan="2"><input placeholder="~+" class="standartInput oneLineInput" type="text" value="{{foundCard.highWave}}"></td>
					<td><input placeholder="E" class="standartInput oneLineInput" type="text" value="{{foundCard.effClass}}"></td>
					</tr>
					<tr>
					<td colspan="4"><input placeholder="Описание" class="standartInput multiLineInput" type="text" value="{{foundCard.desc}}"></td>
					<td style="display:grid"><button class="submitButton">Сохранить</button></td>
					</tr>
				</table>
				
			</div>

			{{> footer}}
			
		</div>
		
	</div>
</body>
</html>