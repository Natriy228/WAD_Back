<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Добавление</title>
    <link rel="stylesheet" href="/WPCdesign.css">
</head>
<body>
    <div class="mainFrame">
	
		<div class="mainContainer">
		
			<div id="videoContainer" style="grid-area:1/1">
				<image style="width:100%; height:100%" src=""></image>
			</div>
			
			<div id="editContainer" style="grid-area:1/1; height:100%; display:grid; align-items:end">
				
				<form method="POST" action="/save-draft" style="display:grid; width:98%; margin-bottom:10%; padding-left:1%">
					<input placeholder="Картинка" class="standartInput oneLineInput" id="img" name="img" type="text" value="{{foundCard.img}}">
					<input placeholder="Видео" class="standartInput oneLineInput" id="vid" name="vid" type="text" style="margin-top:1%" value="{{foundCard.video}}">
					<input placeholder="Название" class="standartInput oneLineInput" id="name" name="name" type="text" style="margin-top:1%" value="{{foundCard.name}}">
					<button class="submitButton" style="margin-top:1%">Сохранить</button>
				</form>

				<form method="POST" action="/public-draft" style="display:grid; width:98%; margin-bottom:25%; padding-left:1%">
					<input placeholder="~-" class="standartInput oneLineInput" type="text" id="LW" name="LW" style="margin-top:1%" value="{{foundCard.lowWave}}"></td>
					<input placeholder="~+" class="standartInput oneLineInput" type="text" id="HW" name="HW" style="margin-top:1%" value="{{foundCard.highWave}}"></td>
					<input placeholder="E" class="standartInput oneLineInput" type="text" id="EC" name="EC" style="margin-top:1%" value="{{foundCard.effClass}}"></td>
					<input placeholder="Описание" class="standartInput multiLineInput" type="text" id="desc" style="margin-top:1%" name="desc" value="{{foundCard.desc}}"></td>
					<button class="submitButton" style="margin-top:1%">Опубликовать</button>
				</form>
				
			</div>

			{{> footer}}
			
		</div>
		
	</div>
</body>
</html>